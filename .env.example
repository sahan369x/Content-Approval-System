# Copy this file to .env.local for local dev, and add the same 3 values
# in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or "Data API") → Project URL
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase → Project Settings → API Keys → "secret" key (sb_secret_...)
# or the legacy "service_role" key. KEEP PRIVATE — server only.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string (32+ chars). Signs the login cookie.
SESSION_SECRET=
